{
  "name": "radar",
  "version": "0.1.0",
  "private": true,
  "description": "Radar — an architectural digest, served at /radar on the shared origin.",
  "author": "Jamie Smith",
  "license": "MIT",
  "scripts": {
    "dev": "next dev --turbopack --port $(microfrontends port)",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@repo/ui": "workspace:*",
    "@vercel/analytics": "^2.0.1",
    "@vercel/microfrontends": "^2.4.0",
    "@vercel/speed-insights": "^2.0.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
