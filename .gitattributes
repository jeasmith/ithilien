# ============================================================================
# Git LFS tracking rules
#
# All binary and large-file types are routed through Git LFS to keep the
# repository fast to clone. Text files are left to standard Git with
# normalised line endings.
#
# To add a new pattern:  git lfs track "*.ext"
# To verify:             git lfs ls-files
# ============================================================================

# ============================================================================
# Line-ending normalisation for text files
#
# This must come BEFORE any binary `-text` rules below, otherwise the global
# `text=auto` attribute would override the binary flags for LFS patterns.
# ============================================================================
* text=auto

# Force LF for web source files (prevents CRLF issues across platforms)
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.mdx text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.sh text eol=lf

# SVGs are text-based XML; track them with normal Git for diffable history.
*.svg text eol=lf

# -- Images ------------------------------------------------------------------
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text
*.avif filter=lfs diff=lfs merge=lfs -text
*.ico filter=lfs diff=lfs merge=lfs -text
*.bmp filter=lfs diff=lfs merge=lfs -text

# Next.js consumes the app favicon during build, so this specific ICO must be
# committed directly instead of relying on a Git LFS checkout.
src/app/favicon.ico -filter -diff -merge -text

