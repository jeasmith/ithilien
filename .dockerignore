# Keep the build context small and never copy host-built artefacts into the
# image. node_modules in particular would carry macOS-native binaries that
# cannot run in a Linux container.

node_modules
.next
.turbo
out
build
coverage

.git
.github

.env
.env.*
!.env.example

npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

.DS_Store
*.swp

.vercel
.idea
.vscode
