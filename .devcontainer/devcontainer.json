{
  "name": "ithilien",
  "dockerComposeFile": "../compose.yaml",
  "service": "dev",
  "workspaceFolder": "/app",
  // The compose service's CMD starts the dev server. For an editor session we
  // want a long-lived container that does not, so the terminal drives it.
  "overrideCommand": true,
  "customizations": {
    "vscode": {
      "extensions": [
        "oxc.oxc-vscode",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss"
      ],
      "settings": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true
      }
    }
  },
  "forwardPorts": [3000]
}
